Algorithme FizzBuzz
DEBUT
  VARIABLE n: ENTIER
  VARIABLE msg: STRING
  ECRIRE("Valeur final")
  LIRE(n)
  POUR i ALLANT DE 1 à n par increment 1
    MSG=""
    SI (i%3==0) ALORS MSG=MSG+"Fizz"
    SI (i%5==0) ALORS MSG=MSG+"Buzz"
    SI (i%7==0) ALORS MSG=MSG+"Wazz"
    SI MSG=="" ALORS ECRIRE(i) SINON ECRIRE(MSG)
  FIN POUR
FIN

Algorithme ValMdP
DEBUT
  VARIABLE Mdp, msg: CHAINE
  VARIABLE cara: CARACTERE
  VARIABLE fort, min, maj, chiff, long: Boolean
  fort=False
  min=False
  maj=False
  chiff=False
  long=False
  ECRIRE("Saisir Mot de passe")
  LIRE("mdp")
  SI (longeur(Mdp>=8)) ALORS 
    long=True
  FIN SI
  SI (longeur(Mdp>0))
    POUR i ALLANT DE 0 à longeur(Mdp) par increment 1
      cara=Mdp[i]
      SI cara>="a" ET cara<="z" ALORS min=True
      SI cara>="A" ET cara<="Z" ALORS maj=True
      SI typeof(cara)==CHIFFRE ALORS chiff=True
    FIN POUR
    
  FIN SI
  fort=long ET min ET maj ET chiff
  SI fort ALORS ECRIRE("Valide") SINON ECRIRE("invalide")
  ECRIRE("Mot de passe Long>8 Majuscule Minuscule Chiffre Valide?")
  msg=Mdp + repeat(" ")
  msg <- SI long ALORS msg+\u2713+"     " SINON msg+`\u2715`+"     "
  msg <- SI maj ALORS msg+\u2713+"     " SINON msg+\u2715+"     "
  msg <- SI min ALORS msg+\u2713+"     " SINON msg+\u2715+"     "
  msg <- SI chiff ALORS msg+\u2713+"     " SINON msg+\u2715+"     "
  msg <- SI fort ALORS msg+\u2713+"     " SINON msg+\u2715+"     "
  ECRIRE(msg)
FIN

Algorithme Tbl Multipl
