Algorithme Calculatrice
DEBUT
  VARIABLE a,b,resultat : REEL
  VARIABLE  op: CHAINE
  ECRIRE ("Premier nombre?")
  LIRE(a)
  ECRIRE ("operation?")
  LIRE(op)
  ECRIRE ("deuxieme nombre?")
  LIRE(b)
  SELON op
    CAS "+" FAIRE
      resultat=a+b
      ECRIRE (resultat)
    CAS "-" FAIRE
      resultat=a-b
      ECRIRE (resultat)
    CAS "*" FAIRE
      resultat=a*b
      ECRIRE (resultat)
    CASE "/" FAIRE
      SI b==0
        ECRIRE ("Erreur : division par zero")
      ELSE
        resultat=a+b
        ECRIRE (resultat)
    CASE ELSE
      ECRIRE ("Erreur : operateur inconnu")
  FIN SWITCH
FIN

Algorithme PgPp 
DEBUT
  VARIABLE bingo, prop, cpt : ENTIER
  VARIABLE cherche: BOOLEAN
  bingo=range(1,100);
  cherche=true;
  cpt=1
  TANT QUE (cherche)
    ECRIRE ("Quel nombre?")
    LIRE(prop)
    SI (prop==bingo) ALORS
      ECRIRE ("Bravo ! Trouve en "+cpt+" essais")
      cherche=False
    SINON SI(prop<bingo) ALORS ECRIRE ("Plus grand !")
    SINON ALORS ECRIRE ("Plus petit !")    
    cpt++
  FIN TANT QUE
FIN
