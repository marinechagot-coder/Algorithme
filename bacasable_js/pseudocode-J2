      ECRIRE(repeat(" ",i-n)+repeat("*",n-i)+repeat(" ",2i-1))
    FIN POUR
  CAS AUTRE FAIRE
FIN SELON

Algorithme ConvRomainversNbr
DEBUT
  VARIABLE rom: CHAINE
  VARIABLE nbr: ENTIER
  VARIABLE car: CARACTERE
  ECRIRE("Chiffre romain:")
  LIRE(rom)
  POUR i DE rom.lenght() A 0 PAR -1
    car=rom[i]
    SELON car
      CAS I FAIRE 
        SI nbr<5 ALORS nbr=nbr+1 SINON nbr=nbr-1
      CAS V FAIRE 
        SI nbr<10 ALORS nbr=nbr+5 SINON nbr=nbr-5
      CAS X FAIRE 
        SI nbr<50 ALORS nbr=nbr+10 SINON nbr=nbr-10   
      CAS L FAIRE 
        SI nbr<100 ALORS nbr=nbr+50 SINON nbr=nbr-50
      CAS C FAIRE 
        SI nbr<500 ALORS nbr=nbr+100 SINON nbr=nbr-100
      CAS D FAIRE 
        SI nbr<1000 ALORS nbr=nbr+500 SINON nbr=nbr-500 
      CAS M FAIRE 
        nbr=nbr+10000 
  FIN POUR
  ECRIRE(nbr)
FIN
Algorithme ConvNbrversRomain
DEBUT
  VARIABLE rom: CHAINE
  VARIABLE nbr,cpt: ENTIER
  VARIABLE ctr:BOOLEAN
  ECRIRE("Chiffre:")
  LIRE(chiff)
  t1=['I','X','C','M']
  t5=['V','L','D']
  cpt=chiff/1000
  rom=repeat('M',cpt)
  chiff=chiff-1000*cpt
  TANT QUE chiff>0 ALORS
    POUR i DE 2 A 0 PAR -1  
      ctr= chiff/(5*10^i)==1
      SI ctr ALORS chiff=chiff-5*10^i
      cpt=chiff/10^i
      SI (ctr) ALORS
        rom = ? SI cpt<4 ALORS rom+t5[i]+repeat(t1[i],cpt) SINON rom+t1[i]+t1[i+1]
      SINON
        rom = ? SI cpt<4 ALORS rom+repeat(t1[i],cpt) SINON rom+t1[i]+t5[i]
      FIN SI
      chiff=chiff-cpt*10^i
  FIN POUR
  ECRIRE(nbr)
FIN