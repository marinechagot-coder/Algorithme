algorithme GestListCourse
DEBUT
  VARIABLE choix, num: ENTIER
  VARIABLE liste[], val, etat: CHAINE
  VARIABLE quitter: BOOLEAN
  quitter=Faux
  ECRIRE("Menu: \n 1.Ajouter un article \n 2.Supprimer un article (par nom) \n 3.Rechercher un article \n 4. Afficher la liste\n 5. Quitter\n")
  TANT QUE !quitter
    Lire(choix)
    SELECTION SELON choix
      CAS 1 FAIRE //création
        ECRIRE("Valeur à saisir")
        LIRE(val)
        AJOUTER val DANS liste
        ECRIRE("Ok")
      CAS 2 FAIRE //Delate
        ECRIRE("Valeur à supprimer")
        LIRE(val)
        Index=rechercher(liste,val) 
        supprimer liste(Index)
        ECRIRE(etat)      
      CAS 3 FAIRE //Recherche
        ECRIRE("Valeur à rechercher")
        LIRE(val) 
        ECRIRE(rechercher(liste,val))      
      CAS 4 FAIRE //Afficher
        POUR i DE 0 A liste.lenght PAR 1
          ECRIRE(i + list(i)) 
      CAS 5 FAIRE 
        quitter=vrai
      CAS AUTRE FAIRE 
        ECRIRE("Commande invalide")

  FIN TANT QUE

FIN
  FONCTION rechercher(tabl : CHAINE[], val: CHAINE) : ENTIER
  DEBUT
      VARIABLE index : ENTIER
      index=tabl.lenght+1
      POUR i ALLANT DE 0 A taille tabl PAR 1
        SI tabl(i)==val ALORS index=i
      FIN POUR
      RETOURNER index
  FIN