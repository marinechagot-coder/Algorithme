Algorithme Stat
DEBUT
  FONCTION minimum(tabl : ENTIER[]) : ENTIER
  DEBUT
      VARIABLE min : ENTIER
      min=tabl[0]
      POUR i ALLANT DE 1 A taille tabl PAR 1
        SI tabl[i]<min ALORS min=tabl[i]
      FIN POUR
      RETOURNER min
  FIN

  FONCTION maximum(tabl : ENTIER[]) : ENTIER
  DEBUT
      VARIABLE max : ENTIER
      max=tabl[0]
      POUR i ALLANT DE 1 A taille tabl PAR 1
        SI tabl[i]>max ALORS max=tabl[i]
      FIN POUR
      RETOURNER max
  FIN
  
  FONCTION moyenne(tabl : ENTIER[]) : REEL
  DEBUT
      VARIABLE moy : REEL
      POUR i ALLANT DE 0 A taille tabl PAR 1
        moy=moy+tabl[i]
      FIN POUR
      moy=moy/moy.taille
      RETOURNER moy
  FIN

  FONCTION ecartType(tabl : ENTIER[]) : REEL
  DEBUT
      VARIABLE ecartT, moy : REEL
      moy=moyenne(tabl)
      POUR i ALLANT DE 0 A taille tabl PAR 1
        ecartT=ecartT+(Ttbl[i]-moy)²
      FIN POUR
      ecartT=racine(ecartT/tabl.taille)
      RETOURNER ecartT
  FIN
  
  FONCTION afficherStats(tabl : ENTIER[]) : vide
  DEBUT
      VARIABLE min,max: ENTIER
      VARIABLE ecartT, moy : REEL
      VARIABLE visuTabl: CHAINE
      min=minimum(tabl)
      max=maximum(tabl)
      moy=moyenne(tabl)
      ecartT=ecartType(tabl)
      visuTabl="["
      POUR i ALLANT DE 0 A tabl.taille PAR 1
        visuTabl=visuTabl+tabl[i]
        visuTabl = SI i!=tabl.taille ALORS visuTabl+"," SINON visuTabl+"]"
      FIN POUR
      ECRIRE("Tableau  Min  Max  Moyenne  Ecart-Type")
      ECRIRE(visuTabl," ",min," ",max," ",moyenne," ",ecartType)
      RETOURNER vide
  FIN
FIN
